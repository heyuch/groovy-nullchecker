<ruleset xmlns="http://codenarc.org/ruleset/1.0">

    <!-- Correctness rules from CodeNarc's default set (empty blocks, broken null checks,
         Class.forName, Boolean.getBoolean, ...). -->
    <ruleset-ref path="rulesets/basic.xml"/>
    <!-- Control statements always use braces. -->
    <ruleset-ref path="rulesets/braces.xml"/>

    <!-- Explicit types everywhere: the project does not use def. -->
    <rule class='org.codenarc.rule.convention.NoDefRule'/>
    <rule class='org.codenarc.rule.convention.VariableTypeRequiredRule'/>
    <rule class='org.codenarc.rule.convention.FieldTypeRequiredRule'/>
    <rule class='org.codenarc.rule.convention.MethodReturnTypeRequiredRule'/>
    <rule class='org.codenarc.rule.convention.MethodParameterTypeRequired'/>

    <!-- A method's result is returned explicitly, not by falling off the last expression. -->
    <rule class='org.codenarc.rule.convention.ImplicitReturnStatementRule'/>

    <!-- Every class states how it is compiled, and all of them are @CompileStatic. The
         DSL's dynamic seam is wrapped in NullChecker (see onClass/onMethod/reportTypeError). -->
    <rule class='org.codenarc.rule.convention.CompileStaticRule'/>

    <!-- Deliberately not enabled:
         PublicMethodsBeforeNonPublicMethods, StaticMethodsBeforeInstanceMethods,
         StaticFieldsBeforeInstanceFields
             Ordering conventions; they fight the grouped-by-responsibility layout.
         IfStatementCouldBeTernary
             Explicit if is preferred; only simple ternaries are allowed.
         ImplicitClosureParameter
             Idiomatic Groovy; enable with the explicit-closure-parameter pass if wanted.
    -->
</ruleset>
